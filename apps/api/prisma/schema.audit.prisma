// prisma/schema.audit.prisma — Audit database schema
// Used by AuditPrismaService with AUDIT_DATABASE_URL

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/audit-client"
}

datasource db {
  provider = "postgresql"
  url      = env("AUDIT_DATABASE_URL")
}

model AuditLog {
  id           String   @id @default(uuid())
  employeeId   String
  employeeName String
  fieldChanged String
  oldValue     String?
  newValue     String?
  changedAt    DateTime @default(now())

  @@map("audit_logs")
}
